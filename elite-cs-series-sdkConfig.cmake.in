@PACKAGE_INIT@

set(_elite_boost_components "@ELITE_BOOST_FIND_COMPONENTS@")
if(_elite_boost_components)
    include(CMakeFindDependencyMacro)
    find_dependency(Boost COMPONENTS ${_elite_boost_components})
endif()
unset(_elite_boost_components)

include("${CMAKE_CURRENT_LIST_DIR}/elite-cs-series-sdkTargets.cmake")
